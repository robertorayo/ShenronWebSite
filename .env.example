# Variables de la función api/deseo.js. Copia este archivo a .env y pon los valores reales (no se sube a git).
# En Vercel se configuran en Project Settings → Environment Variables.

# Clave de Google AI Studio (plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-clave-de-gemini
# Opcional: modelo de Gemini. Si no se pone, se usa el de DEFAULT_MODEL en api/deseo.js.
GEMINI_MODEL=
# Opcional: máximo de llamadas a Gemini al día entre todos los visitantes (por defecto, 400).
GEMINI_DAILY_CAP=

# Upstash Redis (plan gratuito). La integración de Vercel las crea con estos nombres.
KV_REST_API_URL=https://tu-base.upstash.io
KV_REST_API_TOKEN=tu-token-de-upstash

# Texto aleatorio largo para seudonimizar la IP (HMAC) antes de guardarla. Si cambia, los contadores se reinician.
IP_SALT=cambia-esto-por-un-texto-aleatorio-largo
